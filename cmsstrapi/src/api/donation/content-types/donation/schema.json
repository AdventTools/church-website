{
  "kind": "singleType",
  "collectionName": "donations",
  "info": {
    "singularName": "donation",
    "pluralName": "donations",
    "displayName": "Donații",
    "description": "Pagina de donații prin transfer bancar (/donatii). Apare pe site doar când IBAN-ul e completat și pagina e publicată."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "beneficiary": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "iban": {
      "type": "string",
      "regex": "^\\s*[A-Za-z]{2}\\s*[0-9]{2}[A-Za-z0-9\\s]{10,40}$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "bank": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "currency": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "paymentDetails": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "thankYou": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
